# 複製成 .env 後填入（.env 已在 .gitignore，不會被上傳）
# 全部都是選填：什麼都不填也能產出完整報告（使用範例資料 + 規則式摘要）

# ── AI 摘要 ─────────────────────────────
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# ── 資料來源 ───────────────────────────
# 本機 CSV 路徑，或 Google Sheets 分享網址（需設為「知道連結的人可檢視」）
# REPORT_INPUT=https://docs.google.com/spreadsheets/d/<ID>/edit#gid=0
# REPORT_COMPANY=好日子生活百貨

# ── 寄送（加上 --send 才會執行）──────────
# n8n Webhook（POST，JSON 內含摘要與 base64 PDF）
N8N_WEBHOOK_URL=

# Email（Gmail 請使用「應用程式密碼」）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 多位收件人用逗號分隔
REPORT_TO=
